<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gysel_black">

    <LinearLayout
        android:id="@+id/headerDetalleUsuario"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_gyselmood_tienda"
            android:textColor="@color/gysel_light_gray"
            android:textSize="10sp"
            android:letterSpacing="0.09" />

        <TextView
            android:id="@+id/txtTituloPantalla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/ui_detalle_del_producto"
            android:textColor="@color/gysel_white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerDetalleUsuario"
        app:layout_constraintBottom_toTopOf="@id/includeBottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- GALERÍA: ViewPager2 y respaldo, sin duplicar imágenes visibles -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="330dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#25252A"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPagerImagenesProducto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <ImageView
                        android:id="@+id/imgProductoDetalleUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#25252A"
                        android:contentDescription="@string/ui_producto_sin_fotografia"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_gallery"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtIndicadorGaleria"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="14dp"
                        android:background="@drawable/bg_home_product_label"
                        android:paddingStart="13dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="13dp"
                        android:paddingBottom="7dp"
                        android:text="@string/ui_1_3"
                        android:textColor="@color/gysel_white"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/txtCategoriaProductoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/ui_categoria_82"
                android:textColor="@color/gysel_red"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/txtNombreProductoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ui_nombre_del_producto"
                android:textColor="@color/gysel_white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_detail_price"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_precio_por_unidad"
                    android:textColor="@color/gysel_light_gray"
                    android:textSize="11sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/txtPrecioProductoUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/ui_s_0_00"
                    android:textColor="#FF7777"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_home_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_sobre_esta_prenda"
                    android:textColor="@color/gysel_light_gray"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.09" />

                <TextView
                    android:id="@+id/txtDescripcionProductoUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/ui_descripcion_del_producto"
                    android:textColor="@color/gysel_white"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp" />

                <TextView
                    android:id="@+id/txtAdicionalProductoUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/ui_informacion_adicional_85"
                    android:textColor="@color/gysel_light_gray"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtEtiquetaTalla"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/ui_selecciona_tu_talla"
                android:textColor="@color/gysel_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Se elimina el Spinner anterior y su contenedor vacío -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutTallasUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/txtEtiquetaCantidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="@string/ui_cantidad"
                android:textColor="@color/gysel_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_home_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <Button
                    android:id="@+id/btnRestarCantidadUsuario"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:backgroundTint="#393940"
                    android:text="@string/ui_literal_088"
                    android:textColor="@color/gysel_white"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/txtCantidadUsuario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/ui_literal_089"
                    android:textColor="@color/gysel_white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSumarCantidadUsuario"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:backgroundTint="#393940"
                    android:text="@string/ui_literal_090"
                    android:textColor="@color/gysel_white"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- SUBTOTAL ACTUALIZADO SEGÚN CANTIDAD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_detail_price"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ui_subtotal_estimado"
                    android:textColor="@color/gysel_white"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtSubtotalProductoUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_s_0_00"
                    android:textColor="#FF7777"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAgregarCarritoUsuario"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/gysel_red"
                android:text="@string/ui_anadir_al_carrito"
                android:textColor="@color/gysel_white"
                android:textSize="15sp"
                android:textStyle="bold" />


            <Button
                android:id="@+id/btnPersonalizarWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#238B52"
                android:text="@string/ui_personalizar_por_whatsapp"
                android:textColor="@color/gysel_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/ui_consulta_modificaciones_de_diseno_color_o_estamp"
                android:textColor="@color/gysel_light_gray"
                android:textSize="12sp"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/ui_gyselmood_tu_estilo_tu_esencia"
                android:textColor="#777777"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/includeBottomNavigation"
        layout="@layout/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

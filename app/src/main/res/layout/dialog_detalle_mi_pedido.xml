<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#202025"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_detalle_de_tu_compra"
            android:textColor="#AAAAAF"
            android:textSize="11sp"
            android:letterSpacing="0.08"/>

        <TextView
            android:id="@+id/txtDetalleNumero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/ui_pedido_1"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtDetalleFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#B6B6C0"
            android:textSize="12sp"/>

        <!-- ESTADO REAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_busqueda_pedidos"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_estado_actual"
                android:textColor="#AFAFB9"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/txtDetalleEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/ui_pendiente"
                android:textColor="#FFD18C"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtDescripcionEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ui_revisa_el_estado_de_tu_compra"
                android:textColor="#CCCCD4"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:text="@string/ui_productos_207"
            android:textColor="#AAAAAF"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtDetalleProductos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:lineSpacingExtra="5dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="#42424B"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtDetalleSubtotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_subtotal"
                android:textColor="#D6D6DE"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/txtDetalleEnvio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="@string/ui_envio"
                android:textColor="#D6D6DE"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/txtDetalleTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/ui_total_s_0_00"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="22sp"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:text="@string/ui_direccion_de_entrega_209"
            android:textColor="#AAAAAF"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtDetalleDireccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:text="@string/ui_referencia"
            android:textColor="#AAAAAF"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtDetalleReferencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/btnSeguimiento"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="25dp"
            android:text="@string/ui_seguimiento_en_vivo_proximamente"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:enabled="false"/>

        <Button
            android:id="@+id/btnCompletarPago"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="@string/ui_completar_pago"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="#BD3441"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnCerrarDetalle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="@string/ui_cerrar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#44444C"/>

    </LinearLayout>

</ScrollView>

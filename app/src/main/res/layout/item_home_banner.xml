<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:background="@drawable/bg_home_card"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true">

    <!-- IMAGEN CLOUDINARY -->
    <ImageView
        android:id="@+id/imgBannerProducto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Producto destacado"
        android:scaleType="centerCrop"/>

    <!-- DEGRADADO PARA LEGIBILIDAD -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_banner_gradient"/>

    <!-- INFORMACIÓN DEL PRODUCTO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DESTACADO"
            android:textColor="#FF8888"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"/>

        <TextView
            android:id="@+id/txtBannerTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Nombre del producto"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtBannerPrecio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Desde S/ 0.00"
            android:textColor="#FFFFFF"
            android:textSize="15sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="VER PRODUCTO  →"
            android:textColor="#FF9999"
            android:textSize="12sp"
            android:textStyle="bold"/>

    </LinearLayout>

</FrameLayout>

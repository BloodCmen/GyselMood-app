<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gysel_black">

    <!-- Navegación superior -->
    <include
        android:id="@+id/includeTopNavigation"
        layout="@layout/top_navigation"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/includeTopNavigation"
        app:layout_constraintBottom_toTopOf="@id/includeBottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- Avatar -->

            <FrameLayout
                android:id="@+id/contenedorAvatar"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginTop="26dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/txtAvatar"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_account_avatar"
                    android:gravity="center"
                    android:text="@string/ui_u"
                    android:textColor="@color/gysel_white"
                    android:textSize="34sp"
                    android:textStyle="bold"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="top|center_horizontal"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/ui_foto_de_perfil"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/GyselCircular"/>

                <ImageView
                    android:id="@+id/btnCambiarFoto"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="bottom|end"
                    android:padding="9dp"
                    android:background="@drawable/bg_account_avatar"
                    android:src="@android:drawable/ic_menu_camera"
                    android:contentDescription="@string/ui_cambiar_foto_de_perfil"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/gysel_white"/>

            </FrameLayout>


            <!-- Nombre Firebase -->
            <TextView
                android:id="@+id/txtNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/ui_cargando_usuario"
                android:textColor="@color/gysel_white"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/contenedorAvatar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Correo Firebase -->
            <TextView
                android:id="@+id/txtCorreo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="@string/ui_correo_ejemplo_com"
                android:textColor="@color/gysel_light_gray"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/txtNombre"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtSeccionCuenta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:text="@string/ui_mi_actividad"
                android:textColor="@color/gysel_light_gray"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/txtCorreo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Perfil -->
            <TextView
                android:id="@+id/btnPerfil"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_account_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:text="@string/ui_mi_perfil"
                android:textColor="@color/gysel_white"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/txtSeccionCuenta"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Pedidos -->
            <TextView
                android:id="@+id/btnPedidos"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_account_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:text="@string/ui_mis_pedidos"
                android:textColor="@color/gysel_white"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/btnPerfil"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Configuración -->
            <TextView
                android:id="@+id/btnConfiguracion"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_account_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:text="@string/ui_configuracion"
                android:textColor="@color/gysel_white"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/btnPedidos"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />



            <!-- Mis entregas: visible solo para REPARTIDOR -->
            <TextView
                android:id="@+id/btnMisEntregas"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_account_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:text="@string/ui_mis_entregas"
                android:textColor="@color/gysel_white"
                android:textSize="16sp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/btnConfiguracion"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />



            <!-- Salir -->
            <TextView
                android:id="@+id/btnCerrarSesion"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_account_logout"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/ui_cerrar_sesion"
                android:textColor="#FF7474"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/btnMisEntregas"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtPieCuenta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/ui_gyselmood_tu_estilo_tu_esencia"
                android:textColor="#777777"
                android:textSize="11sp"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/btnCerrarSesion"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Navegación inferior -->
    <include
        android:id="@+id/includeBottomNavigation"
        layout="@layout/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

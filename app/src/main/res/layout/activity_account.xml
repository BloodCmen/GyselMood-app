<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gysel_black">

    <!-- Navegación superior -->
    <include
        android:id="@+id/includeTopNavigation"
        layout="@layout/top_navigation"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/includeTopNavigation"
        app:layout_constraintBottom_toTopOf="@id/includeBottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- Avatar -->
            <TextView
                android:id="@+id/txtAvatar"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_account_avatar"
                android:gravity="center"
                android:text="U"
                android:textColor="@color/gysel_white"
                android:textSize="32sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Nombre Firebase -->
            <TextView
                android:id="@+id/txtNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Cargando usuario..."
                android:textColor="@color/gysel_white"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/txtAvatar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Correo Firebase -->
            <TextView
                android:id="@+id/txtCorreo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="correo@ejemplo.com"
                android:textColor="@color/gysel_light_gray"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/txtNombre"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtSeccionCuenta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:text="MI ACTIVIDAD"
                android:textColor="@color/gysel_light_gray"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/txtCorreo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Perfil -->
            <TextView
                android:id="@+id/btnPerfil"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_account_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:text="◉   Mi perfil                         ›"
                android:textColor="@color/gysel_white"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/txtSeccionCuenta"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Pedidos -->
            <TextView
                android:id="@+id/btnPedidos"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_account_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:text="▣   Mis pedidos                       ›"
                android:textColor="@color/gysel_white"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/btnPerfil"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Configuración -->
            <TextView
                android:id="@+id/btnConfiguracion"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_account_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:text="⚙   Configuración                     ›"
                android:textColor="@color/gysel_white"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/btnPedidos"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Salir -->
            <TextView
                android:id="@+id/btnCerrarSesion"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_account_logout"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="↪  CERRAR SESIÓN"
                android:textColor="#FF7474"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/btnConfiguracion"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtPieCuenta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="GYSELMOOD · Tu estilo, tu esencia"
                android:textColor="#777777"
                android:textSize="11sp"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/btnCerrarSesion"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Navegación inferior -->
    <include
        android:id="@+id/includeBottomNavigation"
        layout="@layout/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gysel_black">

    <!-- NAVEGACIÓN SUPERIOR ORIGINAL -->
    <include
        android:id="@+id/includeTopNavigation"
        layout="@layout/top_navigation"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- CABECERA -->
    <LinearLayout
        android:id="@+id/headerCarrito"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toBottomOf="@id/includeTopNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_gyselmood_tu_compra"
            android:textColor="@color/gysel_light_gray"
            android:textSize="10sp"
            android:letterSpacing="0.1"/>

        <TextView
            android:id="@+id/txtTituloCarrito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/ui_mi_carrito"
            android:textColor="@color/gysel_white"
            android:textSize="27sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtContadorCarrito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ui_preparando_tu_carrito"
            android:textColor="@color/gysel_light_gray"
            android:textSize="13sp"/>

    </LinearLayout>

    <!-- ESTADO VACÍO -->
    <LinearLayout
        android:id="@+id/contenedorVacio"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        app:layout_constraintTop_toBottomOf="@id/headerCarrito"
        app:layout_constraintBottom_toTopOf="@id/includeBottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="30dp"
            android:paddingEnd="22dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_literal_015"
                android:textSize="57sp"
                android:contentDescription="@string/ui_bolsa_de_compras"/>

            <TextView
                android:id="@+id/txtMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/ui_tu_carrito_esta_vacio"
                android:textColor="@color/gysel_white"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/ui_descubre_nuestra_coleccion_y_encuentra_tu_proxim"
                android:textColor="@color/gysel_light_gray"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnExplorarProductos"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/gysel_red"
                android:text="@string/ui_explorar_productos"
                android:textColor="@color/gysel_white"
                android:textSize="14sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

    <!-- LISTADO -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCarrito"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="20dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/headerCarrito"
        app:layout_constraintBottom_toTopOf="@id/panelResumen"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- RESUMEN FIJO -->
    <LinearLayout
        android:id="@+id/panelResumen"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="17dp"
        android:paddingEnd="20dp"
        android:paddingBottom="15dp"
        android:background="@drawable/bg_cart_summary"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/includeBottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_resumen_de_compra"
            android:textColor="@color/gysel_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_productos"
                android:textColor="@color/gysel_light_gray"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/txtCantidadResumenCarrito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_0_unidades"
                android:textColor="@color/gysel_white"
                android:textSize="13sp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_envio"
                android:textColor="@color/gysel_light_gray"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_se_calcula_al_continuar"
                android:textColor="@color/gysel_light_gray"
                android:textSize="12sp"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:background="#424248"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_subtotal"
                android:textColor="@color/gysel_white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtSubtotalCarrito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_s_0_00"
                android:textColor="#FF7777"
                android:textSize="24sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnContinuarPedido"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/gysel_red"
            android:text="@string/ui_continuar_pedido"
            android:textColor="@color/gysel_white"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="@string/ui_el_total_final_se_confirma_en_el_checkout"
            android:textColor="@color/gysel_light_gray"
            android:textSize="11sp"/>

    </LinearLayout>

    <!-- NAVEGACIÓN INFERIOR ORIGINAL -->
    <include
        android:id="@+id/includeBottomNavigation"
        layout="@layout/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

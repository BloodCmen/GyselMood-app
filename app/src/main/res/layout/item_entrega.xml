<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#29292F"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtPedidoEntrega"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_pedido_31"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/txtEstadoItemEntrega"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/ui_estado_asignada"
        android:textColor="#FFD18A"
        android:textStyle="bold"
        android:textSize="13sp"/>

    <TextView
        android:id="@+id/txtDireccionItemEntrega"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ui_direccion_de_entrega_230"
        android:textColor="#DDDDDD"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end"/>

    <Button
        android:id="@+id/btnDetalleItemEntrega"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ui_ver_detalles"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#B73C4C"/>

    <Button
        android:id="@+id/btnComoLlegar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ui_como_llegar_con_google_maps"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#32764D"/>


    <Button
        android:id="@+id/btnCompartirGps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/ui_compartir_ubicacion_gps"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#356CB1"
        android:visibility="gone"/>



    <Button
        android:id="@+id/btnIniciarEntrega"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/ui_iniciar_entrega"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#277F53"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnFinalizarEntrega"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/ui_finalizar_entrega"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#B73C4C"
        android:visibility="gone"/>



</LinearLayout>

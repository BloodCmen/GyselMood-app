<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_no_internet">

    <LinearLayout
        android:id="@+id/contenedorCentral"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="@drawable/card_no_internet"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgNoInternet"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/ic_no_internet"
            android:contentDescription="@string/ui_sin_internet" />

        <TextView
            android:id="@+id/txtTituloNoInternet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/ui_ups"
            android:textColor="@color/gysel_white"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMensajeNoInternet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/ui_no_logramos_conectarnos_a_la_red_npuedes_reinten"
            android:textColor="@color/gysel_light_gray"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnReintentar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/gysel_red"
            android:text="@string/ui_reintentar"
            android:textAllCaps="false"
            android:textColor="@color/gysel_white" />

        <Button
            android:id="@+id/btnVerProductosCache"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@android:color/transparent"
            android:text="@string/ui_ver_productos_guardados"
            android:textAllCaps="false"
            android:textColor="@color/gysel_white"
            android:background="@drawable/btn_borde_blanco" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
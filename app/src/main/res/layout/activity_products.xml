<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gysel_black">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:id="@+id/headerCatalogo"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GYSELMOOD / CATÁLOGO"
            android:textColor="@color/gysel_light_gray"
            android:letterSpacing="0.09"
            android:textSize="10sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Explora la colección"
            android:textColor="@color/gysel_white"
            android:textSize="24sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- BUSCADOR -->
    <LinearLayout
        android:id="@+id/contenedorBusqueda"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_home_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="15dp"
        android:paddingEnd="10dp"
        app:layout_constraintTop_toBottomOf="@id/headerCatalogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="Buscar"
            app:tint="@color/gysel_light_gray"/>

        <EditText
            android:id="@+id/edtBuscarCatalogo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@android:color/transparent"
            android:hint="Buscar prendas..."
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/gysel_white"
            android:textColorHint="@color/gysel_light_gray"
            android:textSize="14sp"/>

        <ImageButton
            android:id="@+id/btnLimpiarBusquedaCatalogo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Borrar búsqueda"
            android:visibility="gone"
            app:tint="@color/gysel_light_gray"/>

    </LinearLayout>

    <!-- FILTROS -->
    <LinearLayout
        android:id="@+id/panelFiltros"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/contenedorBusqueda"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:text="CATEGORÍAS"
            android:textColor="@color/gysel_light_gray"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>

        <!-- CATEGORÍAS DESDE LA API -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutCategoriasCatalogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"/>

        </HorizontalScrollView>

        <!-- TALLA Y ORDENAMIENTO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnFiltroTalla"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_home_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Talla: Todas  ▾"
                android:textColor="@color/gysel_white"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/btnOrdenarCatalogo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_home_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Ordenar: Relevancia  ▾"
                android:textColor="@color/gysel_white"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- RESULTADOS Y LIMPIEZA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtResultadosCatalogo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cargando productos..."
                android:textColor="@color/gysel_light_gray"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/btnLimpiarFiltrosCatalogo"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:text="Limpiar filtros"
                android:textColor="@color/gysel_red"
                android:textSize="12sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

    <!-- LISTA CON SCROLL INDEPENDIENTE -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerProductos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/panelFiltros"
        app:layout_constraintBottom_toTopOf="@id/includeBottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- MENSAJE DE VACÍO O ERROR -->
    <TextView
        android:id="@+id/txtEstadoCatalogo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:background="@drawable/bg_home_card"
        android:gravity="center"
        android:minHeight="130dp"
        android:padding="20dp"
        android:text="No encontramos productos"
        android:textColor="@color/gysel_light_gray"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerProductos"
        app:layout_constraintBottom_toBottomOf="@id/recyclerProductos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ProgressBar
        android:id="@+id/progressCatalogo"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:indeterminateTint="@color/gysel_red"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerProductos"
        app:layout_constraintBottom_toBottomOf="@id/recyclerProductos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- NAVBAR -->
    <include
        android:id="@+id/includeBottomNavigation"
        layout="@layout/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

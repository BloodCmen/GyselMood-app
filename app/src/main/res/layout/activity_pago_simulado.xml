<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gysel_black">

    <!-- CABECERA -->
    <LinearLayout
        android:id="@+id/headerPago"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GYSELMOOD / PAGO SEGURO"
            android:textColor="@color/gysel_light_gray"
            android:textSize="10sp"
            android:letterSpacing="0.1"/>

        <TextView
            android:id="@+id/txtTituloPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Finaliza tu compra"
            android:textColor="@color/gysel_white"
            android:textSize="27sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Tu pedido está registrado. Falta confirmar el pago."
            android:textColor="@color/gysel_light_gray"
            android:textSize="13sp"/>

    </LinearLayout>

    <!-- CONTENIDO -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerPago"
        app:layout_constraintBottom_toTopOf="@id/panelAccionPago"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="25dp">

            <!-- IDENTIFICADOR DEL PEDIDO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_home_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NÚMERO DE PEDIDO"
                    android:textColor="@color/gysel_light_gray"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/txtPedidoPago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Pedido #"
                    android:textColor="@color/gysel_white"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="17dp"
                    android:layout_marginBottom="17dp"
                    android:background="#404047"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MÉTODO DE PAGO"
                    android:textColor="@color/gysel_light_gray"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Mercado Pago"
                    android:textColor="@color/gysel_white"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- ESTADO DE PAGO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_detail_price"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ESTADO DEL PAGO"
                    android:textColor="#FFB5B5"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/txtEstadoPago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Consultando el estado del pedido..."
                    android:textColor="@color/gysel_white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="4dp"/>

                <ProgressBar
                    android:id="@+id/progressPago"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="17dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/gysel_red"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- INFORMACIÓN DEL PROCESO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_home_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¿CÓMO FUNCIONA?"
                    android:textColor="#FF8585"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"/>

                <TextView
                    android:id="@+id/txtDescripcionPago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Abriremos Mercado Pago en tu navegador para completar la transacción de forma segura."
                    android:textColor="@color/gysel_white"
                    android:textSize="14sp"
                    android:lineSpacingExtra="5dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="1. Continúa a Mercado Pago.\n2. Completa el pago en su plataforma.\n3. Regresa a GyselMood y verifica el resultado."
                    android:textColor="@color/gysel_light_gray"
                    android:textSize="13sp"
                    android:lineSpacingExtra="6dp"/>

            </LinearLayout>

            <!-- AVISO -->
            <TextView
                android:id="@+id/txtAvisoPago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:gravity="center"
                android:text="Si ya realizaste el pago, verifica su estado antes de intentar pagar nuevamente."
                android:textColor="@color/gysel_light_gray"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

    </ScrollView>

    <!-- ACCIÓN FIJA -->
    <LinearLayout
        android:id="@+id/panelAccionPago"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cart_summary"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="19dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnConfirmarPago"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:backgroundTint="@color/gysel_red"
            android:text="PAGAR CON MERCADO PAGO"
            android:textColor="@color/gysel_white"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="La confirmación dependerá del estado verificado del pago."
            android:textColor="@color/gysel_light_gray"
            android:textSize="11sp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gysel_black">

    <!-- MARCA -->
    <LinearLayout
        android:id="@+id/headerCompraExitosa"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="34dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtMarca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_gyselmood"
            android:textColor="@color/gysel_white"
            android:textSize="23sp"
            android:textStyle="bold"
            android:letterSpacing="0.13"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/ui_confirmacion_de_compra"
            android:textColor="@color/gysel_light_gray"
            android:textSize="10sp"
            android:letterSpacing="0.08"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerCompraExitosa"
        app:layout_constraintBottom_toTopOf="@id/panelVolver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">

            <!-- CÍRCULO DE CONFIRMACIÓN -->
            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/bg_payment_success_circle">

                <TextView
                    android:id="@+id/txtIconoExito"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/ui_literal_054"
                    android:textColor="#80DCA1"
                    android:textSize="66sp"
                    android:textStyle="bold"/>

            </FrameLayout>

            <TextView
                android:id="@+id/txtTituloExito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:gravity="center"
                android:text="@string/ui_pago_confirmado"
                android:textColor="@color/gysel_white"
                android:textSize="27sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtDescripcionExito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/ui_tu_pago_fue_confirmado_correctamente_puedes_cons"
                android:textColor="@color/gysel_light_gray"
                android:textSize="14sp"/>

            <!-- RESUMEN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="29dp"
                android:background="@drawable/bg_home_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_tu_numero_de_pedido"
                    android:textColor="@color/gysel_light_gray"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/txtNumeroPedido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="@string/ui_pedido"
                    android:textColor="@color/gysel_white"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:background="#414148"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_estado_del_pago"
                    android:textColor="@color/gysel_light_gray"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/txtEstadoConfirmado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/ui_pago_aprobado"
                    android:textColor="#80DCA1"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <TextView
                android:id="@+id/txtNotaDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/ui_guarda_tu_numero_de_pedido_para_realizar_consult"
                android:textColor="@color/gysel_light_gray"
                android:textSize="12sp"/>

        </LinearLayout>

    </ScrollView>

    <!-- BOTÓN INFERIOR -->
    <LinearLayout
        android:id="@+id/panelVolver"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cart_summary"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="19dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnVolverCatalogo"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:backgroundTint="@color/gysel_red"
            android:text="@string/ui_volver_a_gyselmood"
            android:textColor="@color/gysel_white"
            android:textSize="14sp"
            android:textStyle="bold"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

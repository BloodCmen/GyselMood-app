<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#151519">

    <TextView
        android:id="@+id/txtTituloSeguimiento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp"
        android:text="@string/ui_seguimiento_de_pedido"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"/>

    <TextView
        android:id="@+id/txtEstadoSeguimiento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text="@string/ui_consultando_repartidor"
        android:textColor="#FFFFFF"
        android:textSize="15sp"/>

    <TextView
        android:id="@+id/txtUltimaActualizacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:text="@string/ui_esperando_ubicacion"
        android:textColor="#AAAAAA"
        android:textSize="12sp"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">


        <org.maplibre.android.maps.MapView
            android:id="@+id/mapaSeguimiento"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


    </FrameLayout>

    <Button
        android:id="@+id/btnCentrarRepartidor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:text="@string/ui_centrar_en_repartidor"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#B73C4C"
        android:enabled="false"/>

</LinearLayout>

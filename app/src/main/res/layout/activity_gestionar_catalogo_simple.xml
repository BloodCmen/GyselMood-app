<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gysel_black">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:id="@+id/headerGestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/ui_literal_101"
            android:textSize="36sp"
            android:textColor="@color/gysel_white"
            android:contentDescription="@string/ui_volver"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_gyselmood_administracion"
                android:textColor="@color/gysel_light_gray"
                android:textSize="10sp"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/txtTituloGestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/ui_gestionar_categorias"
                android:textColor="@color/gysel_white"
                android:textStyle="bold"
                android:textSize="23sp"/>

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerGestion"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="36dp">

            <!-- SECCIÓN CREAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/txtTituloFormulario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_nueva_categoria"
                    android:textColor="@color/gysel_white"
                    android:textStyle="bold"
                    android:textSize="19sp"/>

                <TextView
                    android:id="@+id/txtDescripcionFormulario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/ui_agrega_una_nueva_categoria_al_catalogo"
                    android:textColor="@color/gysel_light_gray"
                    android:textSize="13sp"/>

                <EditText
                    android:id="@+id/edtNombreElemento"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_home_input"
                    android:hint="@string/ui_nombre"
                    android:singleLine="true"
                    android:inputType="textCapWords"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:maxLength="80"
                    android:textColor="@color/gysel_white"
                    android:textColorHint="@color/gysel_light_gray"
                    android:textSize="14sp"/>

                <Button
                    android:id="@+id/btnGuardarElemento"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="15dp"
                    android:backgroundTint="@color/gysel_red"
                    android:text="@string/ui_guardar"
                    android:textColor="@color/gysel_white"
                    android:textStyle="bold"
                    android:textSize="14sp"/>

            </LinearLayout>

            <!-- CABECERA DEL LISTADO -->
            <TextView
                android:id="@+id/txtTituloLista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/ui_categorias_registradas"
                android:textColor="@color/gysel_white"
                android:textSize="19sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtContadorElementos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/ui_cargando_registros"
                android:textColor="@color/gysel_light_gray"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/edtBuscarElemento"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_home_input"
                android:hint="@string/ui_buscar"
                android:inputType="text"
                android:singleLine="true"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="@color/gysel_white"
                android:textColorHint="@color/gysel_light_gray"
                android:textSize="14sp"/>

            <ProgressBar
                android:id="@+id/progressGestion"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/gysel_red"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/txtEstadoLista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/ui_cargando"
                android:textColor="@color/gysel_light_gray"
                android:textSize="14sp"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/contenedorElementos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

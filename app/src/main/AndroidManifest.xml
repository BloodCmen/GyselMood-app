<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GyselMode"
        android:usesCleartextTraffic="true">



        <service
            android:name=".ui.user.entregas.EntregaLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <activity
            android:name=".SplashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>


        <activity
            android:name=".ProductoLinkActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="gyselmood"
                    android:host="producto" />
            </intent-filter>

        </activity>


        <activity android:name=".ui.user.MainActivity" android:exported="false" />
        <activity android:name=".NoInternetActivity" android:exported="false" />
        <activity android:name=".FavoritesActivity" android:exported="false"/>
        <activity android:name=".ui.user.pedidos.CartActivity" android:exported="false"/>
        <activity android:name=".account.AccountActivity" android:exported="false" />
        <activity android:name=".ui.user.ProductosActivity" android:exported="false" />
        <activity android:name=".auth.RegisterActivity" android:exported="false" />
        <activity android:name=".ui.admin.maintenance.MaintenanceActivity" android:exported="false" />
        <activity android:name=".ui.admin.maintenance.CrearProductoActivity" android:exported="false" />
        <activity android:name=".ui.admin.maintenance.GestionarProductosActivity" android:exported="false" />
        <activity android:name=".ui.admin.maintenance.DetalleProductoActivity" android:exported="false" />
        <activity android:name=".ui.admin.maintenance.EditarProductoActivity" android:exported="false" />
        <activity android:name=".ui.admin.maintenance.GestionarTallasActivity" android:exported="false" />
        <activity android:name=".ui.admin.maintenance.GestionarCategoriasActivity" android:exported="false" />
        <activity android:name=".ui.user.pedidos.DetalleProductoUsuarioActivity" android:exported="false" />
        <activity android:name=".ui.user.pedidos.CheckoutActivity" android:exported="false" />
        <activity android:name=".ui.user.pago.PagoSimuladoActivity"  android:exported="false" />
        <activity android:name=".ui.user.pago.CompraExitosaActivity" android:exported="false" />
        <activity android:name=".ui.user.pedidos.MisPedidosActivity" android:exported="false" />
        <activity android:name=".ui.admin.maintenance.GestionPedidosActivity" android:exported="false" />
        <activity android:name=".ui.user.ubicacion.SeleccionarUbicacionActivity" android:exported="false" />
        <activity android:name=".auth.LoginActivity" android:exported="false" />
        <activity android:name=".ui.user.entregas.MisEntregasActivity" android:exported="false" />
        <activity android:name=".ui.user.pedidos.SeguimientoPedidoActivity" android:exported="false" />

    </application>

</manifest>